{
  "name": "@tradejs/strategy-imbalance-momentum",
  "version": "0.0.1",
  "description": "H4 momentum strategy with a three-candle imbalance and an overlap control.",
  "keywords": [
    "ai",
    "claude",
    "codex"
  ],
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "24.x"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@tradejs/core": "^3.1.29-beta.302",
    "@tradejs/strategy-kit": "^3.0.7",
    "@tradejs/types": "^3.1.29-beta.302",
    "prettier": "^3.6.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsup",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "checks": "yarn format:check && yarn typecheck && yarn build && yarn test"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "@tradejs/core": "^3.1.29-beta.302",
    "@tradejs/strategy-kit": "^3.0.7",
    "@tradejs/types": "^3.1.29-beta.302"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TradeJS-Dev/TradeJS-Strategy-ImbalanceMomentum.git"
  }
}
